# Supabase (Project Settings → API) — database only
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# AWS S3 — product images & videos (server)
# AWS_REGION must match the bucket region in S3 → bucket → Properties.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=kicksplosion-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: only if using a custom S3-compatible endpoint
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=true
# Optional override for catalog image URLs (otherwise built from AWS_S3_BUCKET + AWS_REGION at build)
# NEXT_PUBLIC_S3_PUBLIC_URL_BASE=https://your-bucket.s3.your-region.amazonaws.com

# WhatsApp orders (country code + number, digits only, e.g. 923001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=923xxxxxxxxx
# Optional: canonical site URL for WhatsApp message links (production domain)
NEXT_PUBLIC_SITE_URL=https://kicksplosion.store

# Admin (set in Vercel — never commit real values)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password

SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
